{
  "01_soma": [
    {"input": "1 2\n", "expected_output": "3\n"},
    {"input": "999999999999999999 -999999999999999998\n", "expected_output": "1\n"},
    {"input": "  -4    -6  \n", "expected_output": "-10\n"},
    {"input": "7\n8\n", "expected_output": "15\n"}
  ],
  "02_colchetes": [
    {"input": "\n", "expected_output": "VALID\n"},
    {"input": "(((())))\n", "expected_output": "VALID\n"},
    {"input": "{[()]}texto\n", "expected_output": "VALID\n"},
    {"input": "((\n", "expected_output": "INVALID\n"},
    {"input": "{]\n", "expected_output": "INVALID\n"},
    {"input": "'('\n", "expected_output": "INVALID\n"},
    {"input": "// [\n", "expected_output": "INVALID\n"},
    {"input": "abc(def)ghi[jkl]{mno}\n", "expected_output": "VALID\n"}
  ],
  "03_intervalos": [
    {"input": "1\n5 5\n", "expected_output": "5 5\n"},
    {"input": "3\n1 2\n3 4\n5 6\n", "expected_output": "1 6\n"},
    {"input": "3\n1 1\n3 3\n5 5\n", "expected_output": "1 1\n3 3\n5 5\n"},
    {"input": "4\n10 1\n2 3\n4 9\n20 21\n", "expected_output": "1 10\n20 21\n"},
    {"input": "3\n-1 -3\n-2 2\n10 8\n", "expected_output": "-3 2\n8 10\n"},
    {"input": "2\n0 0\n1 1\n", "expected_output": "0 1\n"}
  ],
  "04_janela_minima": [
    {"input": "1\n0 0 1\n", "expected_output": "1\n"},
    {"input": "5\n5\n", "expected_output": "1\n"},
    {"input": "5\n2 3\n", "expected_output": "2\n"},
    {"input": "6\n1 2 3\n", "expected_output": "3\n"},
    {"input": "3\n0 0 0\n", "expected_output": "0\n"},
    {"input": "10\n1 9 0 0\n", "expected_output": "2\n"},
    {"input": "7\n7 0 7\n", "expected_output": "1\n"},
    {"input": "8\n2 2 2 2\n", "expected_output": "4\n"},
    {"input": "9\n\n", "expected_output": "0\n"}
  ],
  "05_rle_unicode": [
    {"input": "a\n", "expected_output": "1:U+0061\n"},
    {"input": "aaaa\n", "expected_output": "4:U+0061\n"},
    {"input": "abab\n", "expected_output": "1:U+0061 1:U+0062 1:U+0061 1:U+0062\n"},
    {"input": "ééa\n", "expected_output": "2:U+00E9 1:U+0061\n"},
    {"input": "🙂🙂\n", "expected_output": "2:U+1F642\n"},
    {"input": "a\n\n", "expected_output": "1:U+0061 1:U+000A\n"},
    {"input": " \n", "expected_output": "1:U+0020\n"},
    {"input": "x\r\n", "expected_output": "1:U+0078\n"}
  ],
  "06_moedas_limitadas": [
    {"input": "10\n1\n5 2\n", "expected_output": "2\n"},
    {"input": "8\n2\n3 2\n2 1\n", "expected_output": "3\n"},
    {"input": "7\n2\n5 1\n2 1\n", "expected_output": "2\n"},
    {"input": "4\n2\n3 1\n1 4\n", "expected_output": "2\n"},
    {"input": "6\n3\n4 1\n2 0\n1 2\n", "expected_output": "3\n"},
    {"input": "100\n3\n50 1\n20 2\n10 1\n", "expected_output": "4\n"},
    {"input": "1\n1\n2 10\n", "expected_output": "IMPOSSIBLE\n"},
    {"input": "9\n2\n5 1\n2 2\n", "expected_output": "3\n"}
  ]
