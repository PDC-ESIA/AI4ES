# Modelo LiteLLM (padrão: GitHub Copilot Chat API).
# Ex.: github_copilot/gpt-4 — ver https://docs.litellm.ai/docs/providers/github_copilot
# Também é possível usar o "gemini-2.5-flash", mas é necessário definir a chave de API da google.
# GOOGLE_API_KEY = chave_api_aqui
ADK_LLM_MODEL=github_copilot/gpt-4

# Diretório de discovery de apps ADK.
# Produção (default): runners
# Desenvolvimento: agents/roles
ADK_AGENTS_DIR=runners

# Diretório base para resolução de caminhos relativos das tools do agente de requisitos.
# Aponta para agents/roles/requirements/ a partir do CWD (adk/).
ADK_AGENT_DATA_DIR=agents/roles/requirements

# Projeto do Google Cloud usado pelo Vertex AI (ID do projeto).
# Ex.: meu-projeto-123456
GOOGLE_CLOUD_PROJECT=seu-id-de-projeto-gcp

# Região onde os recursos do Vertex AI serão executados.
# Ex.: us-central1, southamerica-east1, europe-west1
GOOGLE_CLOUD_LOCATION=sua-regiao-gcp

# Define se o SDK GenAI deve usar Vertex AI.
# Para uso com modelos via Copilot/LiteLLM (ex.: github_copilot/*, groq/*),
# normalmente deixe false. Use true apenas se for consumir modelos do Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=false