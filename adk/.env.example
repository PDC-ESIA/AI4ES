# Modelo LiteLLM (padrão: GitHub Copilot Chat API).
# Ex.: github_copilot/gpt-4 — ver https://docs.litellm.ai/docs/providers/github_copilot
# Também é possível usar o "gemini-2.5-flash", mas é necessário definir a chave de API da google.
# GOOGLE_API_KEY = chave_api_aqui
# Para usar OpenRouter, defina o modelo com o prefixo openrouter/ e a
# OPENROUTER_API_KEY abaixo. Ex.: openrouter/google/gemini-2.5-flash
# ver https://docs.litellm.ai/docs/providers/openrouter
ADK_LLM_MODEL=github_copilot/gpt-4

# Porta do HOST em que o docker compose publica o servidor (API + Dev UI).
# Dentro do container a porta é sempre 8081. Vazio/ausente = 8081.
# Ex.: homologação (pdc1) usa ADK_HOST_PORT=60050.
ADK_HOST_PORT=

# --- OpenRouter (necessário apenas para modelos com prefixo openrouter/) ---
# Chave de API do OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Cabeçalhos recomendados pelo OpenRouter para identificar a aplicação no
# painel/ranking (opcionais). Se vazios, não são enviados.
OPENROUTER_X_TITLE=AI4ES
OPENROUTER_HTTP_REFERER=https://github.com/ceia-pdc/AI4ES

# Fail-fast das chamadas de LLM. O read-timeout default do LiteLLM é 600s;
# com chamadas aninhadas uma credencial expirada/endpoint travado pode pendurar
# o pipeline por dezenas de minutos. Estes limites fazem falhar rápido.
# Timeout por chamada, em segundos (default: 120).
AI4ES_LLM_TIMEOUT=120
# Nº de retries por chamada, com backoff exponencial nativo do LiteLLM (default: 1).
AI4ES_LLM_NUM_RETRIES=1

# Health-check de LLM no início de cada prompt (orchestrator). Valida a
# credencial do GitHub Copilot + faz um ping real ao endpoint; em falha, renova
# o token e revalida antes de abortar. Timeout de cada etapa, em segundos
# (default: 10).
AI4ES_PREFLIGHT_TIMEOUT=10
# Nº de tentativas de renovação de token antes de abortar o prompt (default: 2).
AI4ES_PREFLIGHT_RENEW_ATTEMPTS=2

# Diretório de discovery de apps ADK.
ADK_AGENTS_DIR=src/agents

# --- Observabilidade (logging/tracing NATIVO do ADK) ---
# Nível de log do namespace google_adk e do root logger. Aceita nome
# (DEBUG/INFO/WARNING/ERROR) ou número. Configurado via setup_adk_logger no boot.
LOG_LEVEL=INFO
# Plugin nativo de logging registrado no app (cascateia para os 4 sub-pipelines):
#   off     — nenhum plugin.
#   console — LoggingPlugin: loga no stdout cada ponto crítico (mensagem do
#             usuário, início/fim de agente, request/response de LLM, tool calls
#             com args/resultados, erros). [default]
#   file    — DebugLoggingPlugin: mesma informação, estruturada em YAML.
ADK_LOG_PLUGIN=console
# Caminho do YAML quando ADK_LOG_PLUGIN=file.
ADK_DEBUG_LOG_PATH=workspace_output/adk_debug.yaml

# Diretório base para resolução de caminhos relativos das tools do agente de requisitos.
# Aponta para agents/roles/requirements/ a partir do CWD (adk/).
ADK_AGENT_DATA_DIR=agents/roles/requirements

# Diretório de saída dos agentes (workspace compartilhado).
# Suporta caminhos absolutos, relativos (ao CWD) e com ~ (home do usuário).
# Todos os artefatos produzidos pelos agentes são gravados aqui.
WORKSPACE_OUTPUT_DIR=./workspace_output

# Opcional: caminho absoluto do node quando ele não estiver disponível no PATH.
# Necessário para a execução dos specs Playwright pelo subagente E2E.
PLAYWRIGHT_NODE_EXECUTABLE=

# Chave Google AI — necessária apenas para modelos Gemini nativos.
GOOGLE_API_KEY=

# URL de conexão do banco usado pelo cache de respostas do QA Agent.
# Exemplo local com PostgreSQL: postgresql://postgres:postgres@localhost:5432/qa_agent_cache
DATABASE_URL=

# TTL do cache do QA Agent, em segundos. Ao expirar, a próxima pergunta igual
# volta a chamar o modelo e sobrescreve a entrada.
QA_AGENT_CACHE_TTL_SECONDS=86400

# Tempo máximo, em segundos, para aguardar uma requisição idêntica já em voo
# preencher o cache antes de seguir sem cache (fail-open).
QA_AGENT_CACHE_WAIT_TIMEOUT_SECONDS=300

# Intervalo, em segundos, entre tentativas de adquirir o advisory lock no Postgres.
QA_AGENT_CACHE_POLL_INTERVAL_SECONDS=0.1

# Máximo de artefatos processados em paralelo — ou seja, o limite
# de chamadas simultâneas ao modelo (LLM) durante a geração de testes.

AGENT_MAX_PARALELOS=5
# --- Loop de codificação (workflow coding_review) ---
# Política de continuidade do loop coder <-> executor (issue #394), em
# src/agents/workflow_coding_review/executor/loop_policy.py.
#
# A regra: continuar enquanto o coder estiver AVANÇANDO — seja subindo a nota de
# progresso, seja derrubando uma falha inédita —, parar quando ele empacar no
# mesmo problema. Todos os valores abaixo são os defaults do código; comente uma
# linha para usar o default.

# Teto de iterações do LoopAgent — rede de segurança (last-resort).
# A terminação REAL do loop é decidida pela política de progresso, não por este
# teto. ATENÇÃO ao nome: é MAX_LOOP, não LOOP_MAX.
AI4ES_MAX_LOOP_ITERATIONS=300

# Rodadas consecutivas SEM avanço (nem nota nova, nem falha inédita) que
# caracterizam platô e encerram a task. Mínimo 3.
AI4ES_JANELA_SEM_PROGRESSO=3

# Ganho mínimo na nota para uma rodada contar como progresso. Absorve ruído de
# ponto flutuante e melhoras cosméticas.
AI4ES_MARGEM_MELHORA=0.01

# Rodadas sem avanço exigidas antes que os gatilhos ACELERADORES (sem alteração
# de arquivos, erro repetido) possam encerrar o loop. Precisa ser menor que
# AI4ES_JANELA_SEM_PROGRESSO, senão nunca disparam. Mínimo 2.
AI4ES_RODADAS_PARA_ACELERAR=2

# Quantas falhas DISTINTAS uma task pode atravessar antes de o loop desistir.
# É o freio da política orientada a causa: uma falha inédita renova a tolerância
# (o coder está resolvendo problemas diferentes, ainda que a nota não enxergue
# isso), mas novidade infinita não pode virar loop infinito. Mínimo 2.
#
# Afeta diretamente quantas chamadas de coder/executor/validador uma task pode
# consumir no pior caso — subir este valor aumenta custo e latência.
AI4ES_ORCAMENTO_FALHAS_DISTINTAS=6

# --- Memória entre execuções (mem0), workflow coding_review ---
# Interruptor geral: a feature inteira vem desligada por padrão, 
# para qualquer time. Precisa desta flag como "true" (literal)
# para ligar; com ela ausente, vazia, ou qualquer outro valor, memory_feedforward
# (leitura) e reviewer (escrita) nem chamam o mem0 — zero atividade, nenhum
# banco é sequer inicializado.
AI4ES_MEMORY_ENABLED=

# Postgres é OPCIONAL: Precisa desta flag
# como "true" (literal) para ser considerado; com ela ausente, vazia, ou
# qualquer outro valor, o Postgres é ignorado por completo, mesmo que a URL
# abaixo esteja preenchida (ex.: .env copiado de outra máquina/pessoa).
AI4ES_MEMORY_USE_POSTGRES=

# URL de conexão Postgres/pgvector para a memória do mem0. 
# Só é lida quando a flag acima é "true"; caso
# contrário a memória usa Chroma em arquivo local (adk/memory_store/) — sem
# infra extra, mas não sobrevive fora desta máquina. O Postgres de destino
# precisa ter a extensão `vector` disponível (ex.: imagem pgvector/pgvector)
# — o mem0 cria a extensão sozinho na primeira escrita.
# Exemplo com o serviço memory_postgres do docker-compose.yml (rodando fora
# do compose, porta publicada no host):
# postgresql://ai4es:ai4es_poc_local@localhost:5433/ai4es_memory
AI4ES_MEMORY_DATABASE_URL=

# Override do diretório do armazenamento local (Chroma), usado só quando
# a variável acima não está configurada. Default: adk/memory_store/.
AI4ES_MEMORY_DIR=

# Quantidade de erros acumulados (por stack) que dispara o processamento em
# lote: só erro que se repetiu dentro do lote vira lição gravada no mem0 —
# erro isolado é descartado. Log bruto fica em memory_store/error_log/
# (arquivo local, sem Postgres). Default: 3.
AI4ES_MEMORY_BATCH_THRESHOLD=
# --- Contagem de tokens do orchestrator (shared/pipeline_flags.py) ---
# Todos desligados por padrão: vazio/ausente = comportamento histórico.
# Valores aceitos para ligar: true / 1 / yes / on / sim.

# Grava o consumo no state ao fim de cada workflow e em
# <workspace da sessão>/token_usage.json a cada chamada LLM (sobrevive a queda).
AI4ES_TOKEN_USAGE_PERSIST=
# Emite a tabela parcial de tokens quando a execução pausa.
AI4ES_TOKEN_REPORT_ON_PAUSE=
# Acrescenta o consumo por agente (top 10) à tabela de tokens.
AI4ES_TOKEN_REPORT_DETAIL=
# Acumula as execuções da mesma sessão e mostra o total da sessão.
AI4ES_TOKEN_SESSION_TOTAL=

# --- Coder/reviewer (shared/pipeline_flags.py) ---
# Desligados por padrão: vazio/ausente = comportamento histórico.
# Benchmarks (HumanEval/MBPP) e TACO chamam o coder fora do TaskIterator e
# continuam recebendo a instrução histórica mesmo com estas flags ligadas.

# O coder recebe só a task atual (seção TASK ATUAL, via state) e implementa só
# ela; coder e executor deixam de reenviar o histórico do branch
# (include_contents='none'). Lida no import dos agentes: reinicie o servidor.
AI4ES_CODER_CONTEXTO_ENXUTO=

# Stack conhecida (ex.: Python + FastAPI/Flask) roda com interpretador e
# versões de dependências fixados (shared/execution/trilhas.py). Sem Python da
# trilha no host (python3.12 ou `uv python find 3.12`), a stack segue livre.
AI4ES_TRILHAS=
# Antes do harness, checa sintaxe/import/coleta de testes num venv em cache
# (com trilha) ou faz uma revisão por LLM (sem trilha); falha volta direto ao
# coder sem gastar executor, validador e harness.
AI4ES_VERIFICACAO_RAPIDA=
# Modelo da revisão por LLM (padrão: ADK_LLM_MODEL).
AI4ES_VERIFICACAO_RAPIDA_MODELO=
# Cache dos venvs da verificação rápida (padrão: ~/.cache/ai4se/verificacao_rapida).
AI4ES_VERIFICACAO_RAPIDA_CACHE=

# Um agente separado (cr_acceptance_author) escreve, uma vez por task, os
# testes de aceite em tests/acceptance/ a partir dos critérios; o coder não
# pode editá-los. Eles decidem os critérios no harness (atendido/não atendido)
# e um critério não atendido reprova a rodada. Lida no import do loop: reinicie.
# Produto web (product_type web_app) — SEMPRE: os critérios de interface (o
# context engineer cria ao menos um por funcionalidade de usuário, com ou sem
# esta flag) são testados pelo navegador (Playwright), contra a aplicação no
# ar e partindo da página inicial, em tests/acceptance/test_interface_<TASK>.py.
# O Chromium é baixado no primeiro uso para ~/.cache/ms-playwright.
AI4ES_ACEITE_INDEPENDENTE=
# Cobertura mínima de critérios para aceitar uma task travada "com ressalvas"
# (só com AI4ES_ACEITE_INDEPENDENTE; padrão 0.6).
AI4ES_ACEITE_COBERTURA_MIN=

# Depois da última task, um agente escreve tests/journey/test_jornada.py a
# partir das HUs (fluxos de ponta a ponta + recursos das páginas) e o executa.
# Falhou, vira uma task de integração (TASK-901...) pelo mesmo loop. Lida no
# import do pipeline: reinicie.
AI4ES_JORNADA=
# Rodadas de integração quando a jornada falha (padrão 1; 0 = só mede).
AI4ES_JORNADA_MAX_RODADAS=
# Rodadas seguidas com teste protegido (aceite/jornada) falhando que encerram a
# task, mesmo com erros diferentes a cada rodada (padrão 3).
AI4ES_PROTEGIDOS_MAX_RODADAS=
# Teto de chamadas de LLM por pipeline (RunConfig.max_llm_calls do ADK).
# Padrão 500 (o do ADK); 2000 quando as flags do coder/reviewer estão ligadas.
AI4ES_MAX_LLM_CALLS=
