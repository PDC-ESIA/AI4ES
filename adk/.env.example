# Modelo LiteLLM (padrão: GitHub Copilot Chat API).
# Ex.: github_copilot/gpt-4 — ver https://docs.litellm.ai/docs/providers/github_copilot
# Também é possível usar o "gemini-2.5-flash", mas é necessário definir a chave de API da google.
# GOOGLE_API_KEY = chave_api_aqui
# Para usar OpenRouter, defina o modelo com o prefixo openrouter/ e a
# OPENROUTER_API_KEY abaixo. Ex.: openrouter/google/gemini-2.5-flash
# ver https://docs.litellm.ai/docs/providers/openrouter
ADK_LLM_MODEL=github_copilot/gpt-4

# --- OpenRouter (necessário apenas para modelos com prefixo openrouter/) ---
# Chave de API do OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Cabeçalhos recomendados pelo OpenRouter para identificar a aplicação no
# painel/ranking (opcionais). Se vazios, não são enviados.
OPENROUTER_X_TITLE=AI4ES
OPENROUTER_HTTP_REFERER=https://github.com/ceia-pdc/AI4ES

# Fail-fast das chamadas de LLM. O read-timeout default do LiteLLM é 600s;
# com chamadas aninhadas uma credencial expirada/endpoint travado pode pendurar
# o pipeline por dezenas de minutos. Estes limites fazem falhar rápido.
# Timeout por chamada, em segundos (default: 120).
AI4ES_LLM_TIMEOUT=120
# Nº de retries por chamada, com backoff exponencial nativo do LiteLLM (default: 1).
AI4ES_LLM_NUM_RETRIES=1

# Health-check de LLM no início de cada prompt (orchestrator). Valida a
# credencial do GitHub Copilot + faz um ping real ao endpoint; em falha, renova
# o token e revalida antes de abortar. Timeout de cada etapa, em segundos
# (default: 10).
AI4ES_PREFLIGHT_TIMEOUT=10
# Nº de tentativas de renovação de token antes de abortar o prompt (default: 2).
AI4ES_PREFLIGHT_RENEW_ATTEMPTS=2

# Diretório de discovery de apps ADK.
ADK_AGENTS_DIR=src/agents

# --- Observabilidade (logging/tracing NATIVO do ADK) ---
# Nível de log do namespace google_adk e do root logger. Aceita nome
# (DEBUG/INFO/WARNING/ERROR) ou número. Configurado via setup_adk_logger no boot.
LOG_LEVEL=INFO
# Plugin nativo de logging registrado no app (cascateia para os 4 sub-pipelines):
#   off     — nenhum plugin.
#   console — LoggingPlugin: loga no stdout cada ponto crítico (mensagem do
#             usuário, início/fim de agente, request/response de LLM, tool calls
#             com args/resultados, erros). [default]
#   file    — DebugLoggingPlugin: mesma informação, estruturada em YAML.
ADK_LOG_PLUGIN=console
# Caminho do YAML quando ADK_LOG_PLUGIN=file.
ADK_DEBUG_LOG_PATH=workspace_output/adk_debug.yaml

# Diretório base para resolução de caminhos relativos das tools do agente de requisitos.
# Aponta para agents/roles/requirements/ a partir do CWD (adk/).
ADK_AGENT_DATA_DIR=agents/roles/requirements

# Diretório de saída dos agentes (workspace compartilhado).
# Suporta caminhos absolutos, relativos (ao CWD) e com ~ (home do usuário).
# Todos os artefatos produzidos pelos agentes são gravados aqui.
WORKSPACE_OUTPUT_DIR=./workspace_output

# Opcional: caminho absoluto do node quando ele não estiver disponível no PATH.
# Necessário para a execução dos specs Playwright pelo subagente E2E.
PLAYWRIGHT_NODE_EXECUTABLE=

# Chave Google AI — necessária apenas para modelos Gemini nativos.
GOOGLE_API_KEY=

# URL de conexão do banco usado pelo cache de respostas do QA Agent.
# Exemplo local com PostgreSQL: postgresql://postgres:postgres@localhost:5432/qa_agent_cache
DATABASE_URL=

# TTL do cache do QA Agent, em segundos. Ao expirar, a próxima pergunta igual
# volta a chamar o modelo e sobrescreve a entrada.
QA_AGENT_CACHE_TTL_SECONDS=86400

# Tempo máximo, em segundos, para aguardar uma requisição idêntica já em voo
# preencher o cache antes de seguir sem cache (fail-open).
QA_AGENT_CACHE_WAIT_TIMEOUT_SECONDS=300

# Intervalo, em segundos, entre tentativas de adquirir o advisory lock no Postgres.
QA_AGENT_CACHE_POLL_INTERVAL_SECONDS=0.1

# Máximo de artefatos processados em paralelo — ou seja, o limite
# de chamadas simultâneas ao modelo (LLM) durante a geração de testes.

AGENT_MAX_PARALELOS=5
# --- Loop de codificação (workflow coding_review) ---
# Teto de iterações do LoopAgent — rede de segurança (last-resort).
# A terminação REAL do loop é decidida pelo convergence_checker
# (early-stopping por progresso), não por este teto.
AI4ES_LOOP_MAX_ITERATIONS=300

# Paciência: nº de iterações consecutivas SEM progresso que o
# convergence_checker tolera antes de encerrar o loop.
AI4ES_LOOP_PATIENCE=3

# --- PoC de memória entre execuções (mem0), workflow coding_review ---
# URL de conexão Postgres/pgvector para a memória do mem0 — exclusiva desta
# feature (não reaproveita outro Postgres do projeto, mesmo que exista um
# configurado, de propósito). Se vazio, a memória usa Chroma em arquivo local
# (adk/memory_store/) — sem infra extra, mas não sobrevive fora desta máquina.
# O Postgres de destino precisa ter a extensão `vector` disponível (ex.:
# imagem pgvector/pgvector) — o mem0 cria a extensão sozinho na primeira escrita.
AI4ES_MEMORY_DATABASE_URL=

# Override do diretório do armazenamento local (Chroma), usado só quando
# a variável acima não está configurada. Default: adk/memory_store/.
AI4ES_MEMORY_DIR=
