{
  "schema_version": "1",
  "surface": "service",
  "build": [
    "python -m ensurepip --upgrade",
    "python -m pip install -r requirements.txt"
  ],
  "run": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "test": ["python -m pytest -q"],
  "port": 8000,
  "healthcheck": "/livros",
  "workdir": ".",
  "env": {}
}
